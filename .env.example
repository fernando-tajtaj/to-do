# OPCIONAL. Sin archivo .env la app funciona igual, con estos valores por defecto
# y el correo en MODO PRUEBA (Ethereal): los correos no se entregan de verdad,
# pero se ven con un enlace "Ver correo de prueba".
#
# Para cambiar algo, copia este archivo como .env y deja solo lo que necesites.

# Puerto del servidor (por defecto 3000)
PORT=3000

# URL pública de esta aplicación (se usa para armar el enlace del correo)
APP_URL=http://localhost:3000

# Clave para firmar la cookie de sesión. Cámbiala si publicas la app.
SESSION_SECRET=cambia_esta_clave

# Código que se pide al registrarse con el rol Administrador (por defecto ADMIN123)
CODIGO_ADMIN=ADMIN123

# ── Correo real con BillionMail (requiere un dominio propio con DNS) ──────────
# Si SMTP_HOST está vacío o comentado, se usa el modo prueba.
# Crea un buzón en el panel de BillionMail (Mailbox) y usa sus credenciales.
# SMTP_HOST=mail.tudominio.com
# SMTP_PORT=587
# SMTP_USER=no-reply@tudominio.com
# SMTP_PASS=contraseña_del_buzon
# MAIL_FROM="QA Proyectos <no-reply@tudominio.com>"

# Pon "false" si tu BillionMail usa un certificado autofirmado
# SMTP_TLS_REJECT_UNAUTHORIZED=true
